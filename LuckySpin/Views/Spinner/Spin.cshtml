@model LuckySpin.Models.Spin
<!-- TODO: Be sure to add the Tag Helper annotation (see Index.cshtml) -->
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject LuckySpin.Services.TextTransform TTransform
<!-- TODO: Inject the Repository Service  -->
@inject LuckySpin.Services.Repository _repository

@{
    Layout = "_Layout";
    //TODO: Edit the Display logic below to show the Congratulations message only when the player wins
    string Display = (Model.isWinning(_repository.Player)) ? "display:block" : "display:none";
}
<h1>Lucky Spin</h1>
<button onclick='history.go(0)'>Spin</button> <div>@Model.Numbers[0]</div><div>@Model.Numbers[1]</div><div>@Model.Numbers[2]</div>
<span style="@Display">
    <!-- TODO: Update the message to include the Player's First Name and their Luck value in text format -->
    <h2>Congratulations, @_repository.Player.FirstName<br/>You Win with Lucky @_repository.Player.Luck</h2>
    <img src="/Images/LuckySpinCoins.jpg" class="animated bounce" alt="Coins" />
</span>
<hr/>
<!-- A link to Review the Spins -->
<a asp-controller="Spinner" asp-action="LuckList">see your Luck List</a>